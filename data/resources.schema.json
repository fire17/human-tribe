{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resources.schema.json",
  "title": "השבט האנושי — help resources",
  "description": "Help sources the intake app matches against needs. A row may be marked verified=true ONLY with a working source_url that supports its facts. Unknown extra fields are allowed and ignored by the app.",
  "type": "object",
  "required": [
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sample": {
      "type": "boolean",
      "description": "true = the whole file is fictional sample data"
    },
    "note_he": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "generated_from": {
      "type": "string"
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "shelter",
        "food",
        "clothes",
        "health",
        "mental",
        "addiction",
        "documents",
        "benefits",
        "debts",
        "legal",
        "work",
        "family",
        "other"
      ],
      "description": "shelter=מחסה food=אוכל clothes=בגדים health=בריאות mental=בריאות נפש addiction=התמכרות documents=מסמכים/ת\"ז benefits=ביטוח לאומי/קצבאות debts=חובות legal=ייעוץ משפטי work=עבודה family=קשר משפחתי other=אחר"
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "name_he",
        "category",
        "offers_he",
        "eligibility_he",
        "contact",
        "area",
        "source_url",
        "verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name_he": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "offers_he": {
          "type": "string"
        },
        "eligibility_he": {
          "type": "string"
        },
        "contact": {
          "type": "object",
          "properties": {
            "phone": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "hours": {
              "type": "string"
            }
          }
        },
        "area": {
          "type": "string",
          "description": "e.g. תל אביב-יפו · מרכז · ארצי"
        },
        "source_url": {
          "type": "string",
          "description": "URL of the page that supports these facts; required (http/https) when verified=true"
        },
        "verified": {
          "type": "boolean"
        },
        "sample": {
          "type": "boolean"
        },
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          },
          "description": "categories from the research main field; ranked before side-tag matches"
        },
        "verification_status": {
          "enum": [
            "אומת",
            "אומת (צילום ארכיון)",
            "מקור ישן",
            "לא אומת",
            "לא להפנות"
          ],
          "description": "research lane status words, shown on the badge"
        },
        "verified_date": {
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "direct",
            "wayback",
            "api",
            ""
          ]
        },
        "archive_url": {
          "type": "string",
          "description": "Wayback snapshot actually read (when source_kind=wayback)"
        },
        "snapshot": {
          "type": "string"
        },
        "do_not_refer": {
          "type": "boolean",
          "description": "true = never offered as a match (e.g. inactive org)"
        },
        "notes_he": {
          "type": "string"
        },
        "category_he": {
          "type": "string"
        },
        "needs_he": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array"
        },
        "start_here": {
          "type": "boolean",
          "description": "on the RESOURCES.md where-to-start path; ranked first among verified"
        }
      }
    }
  }
}
